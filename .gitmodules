[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "cograph"]
	path = cograph
	url = https://github.com/sonsoleslp/cograph
[submodule "htna"]
	path = htna
	url = https://github.com/sonsoleslp/htna
[submodule "tna"]
	path = tna
	url = https://github.com/sonsoleslp/tna
